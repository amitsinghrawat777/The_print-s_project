# Server-only. Local values come from `npx supabase status`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=sb_secret_...
PROCESSOR_URL=http://127.0.0.1:4000
# Must match PROCESSOR_SECRET in apps/processor/.env
PROCESSOR_SECRET=change-me-to-a-long-random-string

# Shown in the page title and footer
NEXT_PUBLIC_APP_NAME=The Print's Project
# Optional, for testing from a phone on the same Wi-Fi (your PC's LAN IP)
# ALLOWED_DEV_ORIGINS=192.168.1.20
