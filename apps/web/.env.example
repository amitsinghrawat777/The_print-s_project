# Copy to .env.local. Values below match `supabase start` defaults (local only).
SUPABASE_URL=http://127.0.0.1:54321
# From `supabase status` -> SERVICE_ROLE_KEY. Server-side only; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Private processor service (apps/processor) and its shared HMAC secret.
PROCESSOR_URL=http://127.0.0.1:8080
PROCESSOR_SECRET=dev-processor-secret-change-me
# Salt for hashing client IPs in rate limits.
RATE_LIMIT_SALT=dev-rate-limit-salt
