# Copy to .env.local. Local values come from `npx supabase status`.
# Only the publishable key goes here: the site signs owners in and writes with their own session
# (row level security). Never the secret key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The customer app the QR codes point to
NEXT_PUBLIC_WEB_URL=http://localhost:3030

# Desktop app installers. Leave empty until they are published: the download page then says
# "coming soon" instead of showing a broken link.
NEXT_PUBLIC_DOWNLOAD_WINDOWS_URL=
NEXT_PUBLIC_DOWNLOAD_MAC_URL=

# Shows an email + password form next to Google. Development and automated checks only;
# never set this in production (owners sign in with Google).
NEXT_PUBLIC_ALLOW_PASSWORD_LOGIN=1
