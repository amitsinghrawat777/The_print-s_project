# Copy to .env. Values below match `supabase start` + infra/docker-compose.yml (local only).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Must equal PROCESSOR_SECRET in apps/web/.env.local
PROCESSOR_SECRET=dev-processor-secret-change-me
GOTENBERG_URL=http://127.0.0.1:3001
GHOSTSCRIPT_BIN=gs
PORT=8080
CONCURRENCY=2
SWEEP_INTERVAL_MINUTES=15
LOG_LEVEL=info
