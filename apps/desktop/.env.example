# Copy to .env. Local values come from `npx supabase status`.
# Only the publishable key goes here: it is built into the app. Never the secret key.
RENDERER_VITE_SUPABASE_URL=http://127.0.0.1:54321
RENDERER_VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Where customers order from; used for the shop's QR code.
RENDERER_VITE_WEB_URL=http://localhost:3030
