{
  "name": "the-prints-project",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @prints/web",
    "dev:processor": "npm run dev -w @prints/processor",
    "dev:desktop": "npm run dev -w @prints/desktop",
    "dev:site": "npm run dev -w @prints/site",
    "db:start": "supabase start -x imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "services:up": "docker compose -f infra/docker-compose.yml up -d gotenberg",
    "services:down": "docker compose -f infra/docker-compose.yml down",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "node scripts/smoke-test.mjs",
    "ui-check": "node scripts/ui-check.mjs",
    "site-check": "node scripts/site-check.mjs",
    "marketing-shots": "node scripts/marketing-shots.mjs",
    "desktop-check": "npm run build -w @prints/desktop && node scripts/desktop-check.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.1",
    "supabase": "^2.122.0",
    "typescript": "^5.9.3"
  }
}
